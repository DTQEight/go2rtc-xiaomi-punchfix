# 自包含构建用 Dockerfile（供 GitHub Actions 使用）
# 与 build.sh 等价：下载 go2rtc 源码 -> 应用 punch.patch -> 编译 -> 覆盖官方镜像里的二进制
ARG GO2RTC_VERSION=v1.9.13

FROM golang:1.24-alpine AS build
ARG GO2RTC_VERSION
RUN apk add --no-cache curl patch tar
WORKDIR /src
RUN curl -fsSL "https://github.com/AlexxIT/go2rtc/archive/refs/tags/${GO2RTC_VERSION}.tar.gz" \
      | tar xz --strip-components=1
COPY punch.patch /tmp/punch.patch
# 幂等：已经打过补丁则跳过
RUN if ! grep -q 'waitMsg != msgPunchPkt' pkg/xiaomi/miss/client.go; then \
      patch -p1 < /tmp/punch.patch; \
    fi
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /tmp/go2rtc .

FROM ghcr.io/alexxit/go2rtc:1.9.13
COPY --from=build /tmp/go2rtc /usr/local/bin/go2rtc
